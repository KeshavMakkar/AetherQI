.env
*.env
!.env.example

# Local databases & transient state
*.db
*.sqlite
*.sqlite3
diwali_airwatch.db

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
