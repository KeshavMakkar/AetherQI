# ==============================================================================
# Diwali AirWatch - Environment Configuration & Official Government API Setup
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Government Open Data Platform (data.gov.in)
# ------------------------------------------------------------------------------
# Dataset: Real-time Air Quality Index
# Catalog URL: https://www.data.gov.in/catalog/real-time-air-quality-index
# Registration: Create a free developer account at https://data.gov.in/user/register
# After logging in, copy your API key from My Account -> API Key
DATA_GOV_API_KEY=

# Default official Resource ID for Real-Time AQI dataset
DATA_GOV_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69

# ------------------------------------------------------------------------------
# 2. India Meteorological Department (IMD)
# ------------------------------------------------------------------------------
# API Portal: https://api.imd.gov.in/public/index.php
# Documentation: https://api.imd.gov.in/public/api_reference.html
# Registration: Request academic/public API credentials through IMD's developer portal
IMD_API_KEY=

# ------------------------------------------------------------------------------
# 3. Database Configuration
# ------------------------------------------------------------------------------
# Default SQLite local database path (Zero external database server needed)
DATABASE_URL=sqlite:///./diwali_airwatch.db

# ------------------------------------------------------------------------------
# 4. Ingestion Service & Network Timing
# ------------------------------------------------------------------------------
REFRESH_INTERVAL_MINUTES=30
REQUEST_TIMEOUT_SECONDS=5
MAX_RETRIES=2

# Maximum radius (km) to evaluate spatial coverage reliability
MAX_STATION_RADIUS_KM=25.0

# Explicitly isolate demo / fallback data
ALLOW_DEMO_DATA=True

