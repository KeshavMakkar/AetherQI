{
  "standard_name": "CPCB National Air Quality Index (IND-AQI)",
  "authority": "Central Pollution Control Board, Ministry of Environment, Forest and Climate Change (MoEFCC), Govt. of India",
  "reference_url": "https://cpcb.nic.in/National-Air-Quality-Index/",
  "minimum_pollutant_count_required": 3,
  "mandatory_pollutants": ["PM2.5", "PM10"],
  "categories": [
    { "name": "Good", "min_aqi": 0, "max_aqi": 50, "color": "#00B050", "health_impact": "Minimal impact." },
    { "name": "Satisfactory", "min_aqi": 51, "max_aqi": 100, "color": "#92D050", "health_impact": "Minor breathing discomfort to sensitive people." },
    { "name": "Moderate", "min_aqi": 101, "max_aqi": 200, "color": "#FFFF00", "health_impact": "Breathing discomfort to people with lungs, asthma and heart diseases." },
    { "name": "Poor", "min_aqi": 201, "max_aqi": 300, "color": "#FF9900", "health_impact": "Breathing discomfort to most people on prolonged exposure." },
    { "name": "Very Poor", "min_aqi": 301, "max_aqi": 400, "color": "#FF0000", "health_impact": "Respiratory illness on prolonged exposure." },
    { "name": "Severe", "min_aqi": 401, "max_aqi": 500, "color": "#C00000", "health_impact": "Affects healthy people and seriously impacts those with existing diseases." }
  ],
  "pollutants": {
    "PM2.5": {
      "unit": "µg/m³",
      "averaging_period": "24-hour",
      "breakpoints": [
        { "c_low": 0, "c_high": 30, "i_low": 0, "i_high": 50 },
        { "c_low": 30.1, "c_high": 60, "i_low": 51, "i_high": 100 },
        { "c_low": 60.1, "c_high": 90, "i_low": 101, "i_high": 200 },
        { "c_low": 90.1, "c_high": 120, "i_low": 201, "i_high": 300 },
        { "c_low": 120.1, "c_high": 250, "i_low": 301, "i_high": 400 },
        { "c_low": 250.1, "c_high": 500, "i_low": 401, "i_high": 500 }
      ]
    },
    "PM10": {
      "unit": "µg/m³",
      "averaging_period": "24-hour",
      "breakpoints": [
        { "c_low": 0, "c_high": 50, "i_low": 0, "i_high": 50 },
        { "c_low": 50.1, "c_high": 100, "i_low": 51, "i_high": 100 },
        { "c_low": 100.1, "c_high": 250, "i_low": 101, "i_high": 200 },
        { "c_low": 250.1, "c_high": 350, "i_low": 201, "i_high": 300 },
        { "c_low": 350.1, "c_high": 430, "i_low": 301, "i_high": 400 },
        { "c_low": 430.1, "c_high": 600, "i_low": 401, "i_high": 500 }
      ]
    },
    "NO2": {
      "unit": "µg/m³",
      "averaging_period": "24-hour",
      "breakpoints": [
        { "c_low": 0, "c_high": 40, "i_low": 0, "i_high": 50 },
        { "c_low": 40.1, "c_high": 80, "i_low": 51, "i_high": 100 },
        { "c_low": 80.1, "c_high": 180, "i_low": 101, "i_high": 200 },
        { "c_low": 180.1, "c_high": 280, "i_low": 201, "i_high": 300 },
        { "c_low": 280.1, "c_high": 400, "i_low": 301, "i_high": 400 },
        { "c_low": 400.1, "c_high": 600, "i_low": 401, "i_high": 500 }
      ]
    },
    "SO2": {
      "unit": "µg/m³",
      "averaging_period": "24-hour",
      "breakpoints": [
        { "c_low": 0, "c_high": 40, "i_low": 0, "i_high": 50 },
        { "c_low": 40.1, "c_high": 80, "i_low": 51, "i_high": 100 },
        { "c_low": 80.1, "c_high": 380, "i_low": 101, "i_high": 200 },
        { "c_low": 380.1, "c_high": 800, "i_low": 201, "i_high": 300 },
        { "c_low": 800.1, "c_high": 1600, "i_low": 301, "i_high": 400 },
        { "c_low": 1600.1, "c_high": 2500, "i_low": 401, "i_high": 500 }
      ]
    },
    "CO": {
      "unit": "mg/m³",
      "averaging_period": "8-hour",
      "breakpoints": [
        { "c_low": 0.0, "c_high": 1.0, "i_low": 0, "i_high": 50 },
        { "c_low": 1.01, "c_high": 2.0, "i_low": 51, "i_high": 100 },
        { "c_low": 2.01, "c_high": 10.0, "i_low": 101, "i_high": 200 },
        { "c_low": 10.01, "c_high": 17.0, "i_low": 201, "i_high": 300 },
        { "c_low": 17.01, "c_high": 34.0, "i_low": 301, "i_high": 400 },
        { "c_low": 34.01, "c_high": 50.0, "i_low": 401, "i_high": 500 }
      ]
    },
    "O3": {
      "unit": "µg/m³",
      "averaging_period": "8-hour",
      "breakpoints": [
        { "c_low": 0, "c_high": 50, "i_low": 0, "i_high": 50 },
        { "c_low": 50.1, "c_high": 100, "i_low": 51, "i_high": 100 },
        { "c_low": 100.1, "c_high": 168, "i_low": 101, "i_high": 200 },
        { "c_low": 168.1, "c_high": 208, "i_low": 201, "i_high": 300 },
        { "c_low": 208.1, "c_high": 748, "i_low": 301, "i_high": 400 },
        { "c_low": 748.1, "c_high": 1000, "i_low": 401, "i_high": 500 }
      ]
    },
    "NH3": {
      "unit": "µg/m³",
      "averaging_period": "24-hour",
      "breakpoints": [
        { "c_low": 0, "c_high": 200, "i_low": 0, "i_high": 50 },
        { "c_low": 200.1, "c_high": 400, "i_low": 51, "i_high": 100 },
        { "c_low": 400.1, "c_high": 800, "i_low": 101, "i_high": 200 },
        { "c_low": 800.1, "c_high": 1200, "i_low": 201, "i_high": 300 },
        { "c_low": 1200.1, "c_high": 1800, "i_low": 301, "i_high": 400 },
        { "c_low": 1800.1, "c_high": 2500, "i_low": 401, "i_high": 500 }
      ]
    }
  }
}

